# Copy to .env.local (or .env) and adjust. Never commit real secrets.
#
# Base URL of the Tedor Tutors API.
# Leave unset in development: requests then go to the same-origin /api path,
# which the Vite dev server proxies to the backend (VITE_DEV_API_TARGET).
# Set it when the API lives on another host, e.g. in production.
# VITE_API_URL=https://api.example.com

# Where the Vite dev server proxies /api requests during development.
VITE_DEV_API_TARGET=http://localhost:4000

# Contact details shown to tutors on the application status page while their
# profile is under review, so they can send documents or ask a question.
#
# Both are safe to leave blank: the matching button is simply not rendered, so a
# deployment with one channel shows one button rather than a dead link. Use a
# bare handle or number with no scheme — the page builds the link — e.g.
# "@Tedor_Team" for Telegram (the @ is optional) and "+447700900123" for WhatsApp.
# Requirements: 32.1, 32.2, 32.5
VITE_CONTACT_TELEGRAM=
VITE_CONTACT_WHATSAPP=

# Email address shown in the footer's Support column.
#
# Optional: with no value the line is not rendered, so a deployment that has not
# chosen an address shows no broken mailto. Only a plain address is accepted —
# anything containing a ?, # or whitespace is ignored rather than turned into a
# surprising link.
VITE_CONTACT_EMAIL=

# The same Telegram handle, shown to learners on the confirmation they see after
# sending a tutor request, so they can follow up instead of waiting.
#
# Unlike the two variables above, leaving this blank does NOT hide the button: it
# falls back to the published Tedor Tutors account. Set it only to point a
# deployment at a different account.

# Social profile links shown in the site footer.
#
# Every one is optional and safe to leave blank. A blank platform renders as a
# muted, non-clickable slot, so the row keeps its shape as you fill it in and a
# half-configured deployment shows no dead links.
#
# Full URLs work, and so do partial ones: a bare handle ("@tedortutors",
# "tedortutors") is prefixed with the platform's host, and a value that already
# names a host without a scheme ("x.com/tedortutors") is given "https://".
# Only http and https links are accepted.
#
# You can also edit the same six values directly in src/lib/socialConfig.ts,
# marked with "REPLACE THESE". The environment wins where both are set.
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
