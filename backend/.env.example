# Copy to .env and fill in real values. Never commit .env.
#
# PostgreSQL connection string. Create the role and database once:
#   CREATE ROLE tedorpath LOGIN PASSWORD '<password>';
#   CREATE DATABASE tedorpath OWNER tedorpath;
DATABASE_URL="postgresql://tedorpath:CHANGE_ME@127.0.0.1:5432/tedorpath?schema=public"

# Port the API listens on.
PORT=4000

# Where uploaded tutor profile photos are written. Optional; defaults to
# `uploads/` beside the backend. This is local disk, which suits a single-node
# deployment — a multi-instance deploy needs shared storage instead.
UPLOAD_DIR=uploads

# Comma-separated list of browser origins allowed to call the API.
# Must be explicit — do not use a wildcard in production. Credentialed requests
# (the sign-in session cookie) are only sent when the browser's origin is on
# this list, so every environment the frontend is served from must be here.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# How long a sign-in session stays valid, in days. Optional (default 30).
# Sessions are opaque random tokens stored as a SHA-256 digest, so there is no
# signing secret to configure or rotate — signing out revokes the row directly.
SESSION_TTL_DAYS=30

# Google sign-in (OAuth 2.0 / OpenID Connect).
# Optional: with no client id the provider is simply switched off and the
# /api/auth/google endpoint answers with GOOGLE_NOT_CONFIGURED.
# Both values must stay in the backend environment — anything named VITE_* is
# inlined into the browser bundle and is public.
# The client id is not a secret; the client secret is.
GOOGLE_CLIENT_ID=""
# Whether to OFFER Google sign-in. Defaults to true when a client id is set.
# Set to false to keep the button off while the OAuth client is still being
# configured, instead of sending visitors to a Google error page.
GOOGLE_AUTH_ENABLED=true
# Optional. The flow uses PKCE, so a public client does not need a secret. A
# confidential "Web application" client is issued one and Google rejects the
# token exchange without it (error: invalid_client).
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to this server's origin + /api/auth/google/callback. Set it
# when the API sits behind a proxy and that default is not the public address.
# It must match a redirect URI registered in the Google Cloud console exactly:
#   http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI=""
# Where the browser is sent once sign-in finishes. This must be the website, not
# the API — Google returns the visitor to the API, and it has to end up on the
# app. Optional: falls back to the first CORS_ORIGINS entry, then to this
# server's own origin.
FRONTEND_URL=""

# Development-only shared secret for /api/admin.
# This is NOT authentication — it is a single static token with no users,
# roles or sessions. Replace it with real staff authentication before any
# public deployment. It must stay in the backend environment: anything named
# VITE_* is inlined into the browser bundle and is public.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_TOKEN="CHANGE_ME"
