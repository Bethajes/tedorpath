# Copy to .env and fill in real values. Never commit .env.
#
# PostgreSQL connection string. Create the role and database once:
#   CREATE ROLE tedorpath LOGIN PASSWORD '<password>';
#   CREATE DATABASE tedorpath OWNER tedorpath;
DATABASE_URL="postgresql://tedorpath:CHANGE_ME@127.0.0.1:5432/tedorpath?schema=public"

# Port the API listens on.
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# Must be explicit — do not use a wildcard in production.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Development-only shared secret for /api/admin.
# This is NOT authentication — it is a single static token with no users,
# roles or sessions. Replace it with real staff authentication before any
# public deployment. It must stay in the backend environment: anything named
# VITE_* is inlined into the browser bundle and is public.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_TOKEN="CHANGE_ME"
